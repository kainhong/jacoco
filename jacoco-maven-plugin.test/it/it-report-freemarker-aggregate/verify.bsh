import org.codehaus.plexus.util.*;
import java.util.regex.*;

String buildLog = FileUtils.fileRead( new File( basedir, "build.log" ) );

if ( !Pattern.compile( "Loading execution data file \\S*child1.target.jacoco.exec").matcher( buildLog ).find() ) {
    throw new RuntimeException( "Execution data from child1 was not loaded." );
}

if ( !Pattern.compile( "Loading execution data file \\S*child1-test.target.jacoco.exec").matcher( buildLog ).find() ) {
    throw new RuntimeException( "Execution data from child1-test was not loaded." );
}

if ( !new File( basedir, "child2/target/jacoco.exec" ).isFile()) {
    throw new RuntimeException( "No execution data in child2." );
}
if ( Pattern.compile( "Loading execution data file \\S*child2.target.jacoco.exec").matcher( buildLog ).find() ) {
    throw new RuntimeException( "Execution data from child2 was loaded, whereas range should exclude it." );
}
if ( !Pattern.compile( "Loading execution data file \\S*child2v2.target.jacoco.exec").matcher( buildLog ).find() ) {
    throw new RuntimeException( "Execution data from child2v2 was not loaded." );
}

if ( !Pattern.compile( "Loading execution data file \\S*report.target.jacoco.exec").matcher( buildLog ).find() ) {
    throw new RuntimeException( "Execution data from report was not loaded." );
}

File reportChild1 = new File( basedir, "report/target/site/jacoco-aggregate/child1/index.html" );
if ( !reportChild1.isFile() ) {
    throw new RuntimeException( "Report for child1 was not created." );
}

File reportChild1test = new File( basedir, "report/target/site/jacoco-aggregate/child1-test/index.html" );
if ( reportChild1test.isFile() ) {
    throw new RuntimeException( "Report for child1-test should not be created." );
}

File reportChild2 = new File( basedir, "report/target/site/jacoco-aggregate/child2/index.html" );
if ( !reportChild2.isFile() ) {
    throw new RuntimeException( "Report for child2 was not created." );
}

// Freemarker specific checks
File mainIndex = new File( basedir, "report/target/site/jacoco-aggregate/index.html");
if (!mainIndex.isFile()) {
    throw new RuntimeException( "Freemarker main index.html not found." );
}

// Check for jacoco-resources
File cssFile = new File( basedir, "report/target/site/jacoco-aggregate/jacoco-resources/report.css");
if (!cssFile.isFile()) {
    throw new RuntimeException( "Freemarker report.css not found in jacoco-resources." );
}
File prettifyJs = new File( basedir, "report/target/site/jacoco-aggregate/jacoco-resources/prettify.js");
if (!prettifyJs.isFile()) {
    throw new RuntimeException( "Freemarker prettify.js not found in jacoco-resources." );
}
File reportGif = new File( basedir, "report/target/site/jacoco-aggregate/jacoco-resources/report.gif");
if (!reportGif.isFile()) {
    throw new RuntimeException( "Freemarker report.gif not found in jacoco-resources." );
}


// Content checks for main index.html
String mainIndexContent = FileUtils.fileRead(mainIndex);
if (!mainIndexContent.contains("<title>JaCoCo Code Coverage Report - report</title>")) {
    // Note: Title comes from <title> element in AbstractReportMojo, which defaults to ${project.name}
    // For the 'report' module, project.name is "Aggregate Report".
    // The Freemarker template uses bundleName, which is the structure name.
    // The default structure name in ReportMojo is project.getName().
    // Let's assume the title is "Aggregate Report" (name of the reporting module)
    // The main_page.ftl uses ${bundleName} for the title.
    // The bundleName is set from the <structure name="?..."> in Ant, or project.name in Maven.
    // For aggregated report, the title is set in ReportSupport.java processProject() to the project's name.
    // The 'report' module's name is "Aggregate Report".
    // The Freemarker template main_page.ftl has <title>JaCoCo Code Coverage Report - ${bundleName}</title>
    // So, title should be "JaCoCo Code Coverage Report - Aggregate Report"
    // The ReportMojo sets title to project.getName() which is "Aggregate Report" for this IT.
    // The title for the bundle in FreemarkerFormatter is taken from bundle.getName().
    // In `ReportSupport.processProject`, the bundleName for the root is `project.getName()`.
    // So, this should be "Aggregate Report".
    // The template `main_page.ftl` has: <title>JaCoCo Code Coverage Report - ${bundleName}</title>
    // So, we expect: <title>JaCoCo Code Coverage Report - Aggregate Report</title>
    // The title in AbstractReportMojo defaults to ${project.name}. For the 'report' module, this is "Aggregate Report".
    // This title is passed to ReportSupport, which uses it as the bundle name.
    if (!mainIndexContent.contains("<title>JaCoCo Code Coverage Report - Aggregate Report</title>")) {
        throw new RuntimeException( "Freemarker main index.html does not contain expected title." );
    }
}

if (!mainIndexContent.contains("href=\"jacoco-resources/report.css\"")) {
    throw new RuntimeException( "Freemarker main index.html does not link jacoco-resources/report.css." );
}

// Check for a package link (child1 is a good candidate)
if (!mainIndexContent.contains("href=\"child1/index.html\"")) {
    throw new RuntimeException( "Freemarker main index.html does not contain link to child1 package." );
}


// Content checks for a package page (child1/index.html)
String packagePageContent = FileUtils.fileRead(reportChild1); // reportChild1 is child1/index.html
if (!packagePageContent.contains("<title>JaCoCo Code Coverage Report - org.example</title>")) {
    // The group_name in group_page.ftl is the package name.
    // Child1's main package is org.example
    throw new RuntimeException( "Freemarker package page (child1) does not contain expected title 'org.example'." );
}
if (!packagePageContent.contains("href=\"../jacoco-resources/report.css\"")) {
    // Relative link from package page to jacoco-resources
    throw new RuntimeException( "Freemarker package page (child1) does not link ../jacoco-resources/report.css." );
}
// Check for a class link (Child1.java.html)
// The class is org.example.Child1, source file Child1.java
if (!packagePageContent.contains("href=\"Child1.java.html\"")) {
    throw new RuntimeException( "Freemarker package page (child1) does not link to Child1.java.html." );
}


// Check for a source file and its content.
// Source file for org.example.Child1 in module child1
File sourceFile = new File( basedir, "report/target/site/jacoco-aggregate/child1/org.example/Child1.java.html" );
if (!sourceFile.isFile()) {
    throw new RuntimeException( "Freemarker source file Child1.java.html not found." );
}
String sourceFileContent = FileUtils.fileRead(sourceFile);
if (!sourceFileContent.contains("<title>JaCoCo Code Coverage Report - Child1.java</title>")) {
    throw new RuntimeException( "Freemarker source page Child1.java.html does not contain expected title." );
}
if (!sourceFileContent.contains("href=\"../../jacoco-resources/report.css\"")) {
    throw new RuntimeException( "Freemarker source page does not link ../../jacoco-resources/report.css." );
}
if (!sourceFileContent.contains("href=\"../../jacoco-resources/prettify.css\"")) {
    throw new RuntimeException( "Freemarker source page does not link ../../jacoco-resources/prettify.css." );
}
if (!sourceFileContent.contains("prettyPrint()")) {
    throw new RuntimeException( "Freemarker source page does not call prettyPrint()." );
}
// Check for a covered line CSS class (fc = fully covered)
if (!sourceFileContent.contains("class=\"fc\"")) {
    System.out.println("WARNING: Source page does not contain any fully covered line class 'fc'. Might be an issue with test data or coverage.");
    // This might not be a strict failure if test data results in no fully covered lines, but good to note.
}
if (!sourceFileContent.contains("class=\"nc\"")) {
    System.out.println("WARNING: Source page does not contain any not covered line class 'nc'. Might be an issue with test data or coverage.");
}

System.out.println("Freemarker IT assertions completed.");
